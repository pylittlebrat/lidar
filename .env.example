# Simulation Tech Radar 环境变量示例
# 复制为 .env 后按需修改（V1 不自动加载 .env，请在 shell 中 export 或设置系统环境变量）

# 配置目录（默认：项目根目录下的 config/）
# TECHRADAR_CONFIG_DIR=./config

# 数据目录（默认：项目根目录下的 data/，radar.db 位于其下）
# TECHRADAR_DATA_DIR=./data

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
TECHRADAR_LOG_LEVEL=INFO

# 日志文件路径（留空则仅输出到控制台）
# TECHRADAR_LOG_FILE=./data/logs/techradar.log

# ---------------- Phase 2+ 预留（暂不使用） ----------------
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_API_BASE=https://api.github.com
# ARXIV_QUERY_LIMIT=30

# ---------------- LLM（Phase 4，OpenCode Zen/Go 示例） ----------------
# LLM_API_KEY=oc_sk_xxxxxxxxxxxx
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=deepseek-v4-flash
# LLM_TIMEOUT_SECONDS=90
# TECHRADAR_SESSION_ID=stable-session-id（同一会话保持稳定，利于 opencode 路由/缓存）